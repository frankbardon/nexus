{
  "id": "tools-and-reasoning-together",
  "title": "A reasoning turn that also carries tools and structured output",
  "rationale": "The combination is the realistic agent turn and the one where an ordering bug hides: the strip runs after the body is written, the tool array is flat and explicitly non-strict, and structured output sits under text.format -- all at once, on one request, rather than one feature per vector.",
  "model": "gpt-5.1",
  "max_tokens": 16000,
  "temperature": 0.4,
  "reasoning": {"mode": "effort", "effort": "medium", "summary": "detailed"},
  "messages": [
    {"role": "system", "content": "Be precise."},
    {"role": "user", "content": "Plan the migration."}
  ],
  "tools": [
    {
      "name": "shell",
      "description": "Run a command.",
      "parameters": {"type": "object", "properties": {"cmd": {"type": "string"}}, "required": ["cmd"]}
    }
  ],
  "response_format": {"type": "json_object"},
  "body": {
    "model": "gpt-5.1",
    "max_output_tokens": 16000,
    "store": false,
    "input": [
      {"role": "system", "content": "Be precise."},
      {"role": "user", "content": "Plan the migration."}
    ],
    "tools": [
      {
        "type": "function",
        "name": "shell",
        "description": "Run a command.",
        "strict": false,
        "parameters": {"type": "object", "properties": {"cmd": {"type": "string"}}, "required": ["cmd"]}
      }
    ],
    "text": {"format": {"type": "json_object"}},
    "reasoning": {"effort": "medium", "summary": "detailed"}
  }
}
