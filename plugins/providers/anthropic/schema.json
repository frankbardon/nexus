{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/plugins/nexus.llm.anthropic.json",
  "title": "nexus.llm.anthropic",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "debug":        {"type": "boolean", "description": "Persist request/response bodies to the session for debugging."},
    "auth_mode":    {"type": "string", "enum": ["api_key", "bedrock", "vertex"], "description": "Authentication mode."},
    "api_key":      {"type": "string", "description": "Direct API key (auth_mode: api_key)."},
    "api_key_env":  {"type": "string", "description": "Environment variable to read the API key from."},
    "auth": {
      "type": "object",
      "description": "Optional structured auth block; mirrors auth_mode subkeys.",
      "additionalProperties": true
    },
    "bedrock": {
      "type": "object",
      "additionalProperties": false,
      "description": "AWS Bedrock auth block.",
      "properties": {
        "region":                    {"type": "string"},
        "access_key_id":             {"type": "string"},
        "access_key_id_env":         {"type": "string"},
        "secret_access_key":         {"type": "string"},
        "secret_access_key_env":     {"type": "string"},
        "session_token":             {"type": "string"},
        "session_token_env":         {"type": "string"}
      }
    },
    "vertex": {
      "type": "object",
      "additionalProperties": false,
      "description": "GCP Vertex AI auth block.",
      "properties": {
        "project":                  {"type": "string"},
        "project_id":               {"type": "string"},
        "region":                   {"type": "string"},
        "location":                 {"type": "string"},
        "sa_key_file":              {"type": "string"},
        "sa_key_file_env":          {"type": "string"},
        "service_account_json":     {"type": "string"},
        "service_account_json_env": {"type": "string"}
      }
    },
    "project_id":               {"type": "string", "description": "Top-level Vertex project ID alias."},
    "location":                 {"type": "string", "description": "Top-level Vertex region alias."},
    "service_account_json":     {"type": "string", "description": "Top-level Vertex SA JSON path alias."},
    "service_account_json_env": {"type": "string", "description": "Top-level Vertex SA JSON env-var alias."},
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":        {"type": "boolean"},
        "system":         {"type": "boolean"},
        "tools":          {"type": "boolean"},
        "message_prefix": {"type": "integer", "minimum": 0},
        "ttl":            {"type": "string", "description": "5m or 1h."}
      }
    },
    "thinking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode":             {"type": "string", "enum": ["adaptive", "budget", "disabled", "off"], "description": "Wire shape for the thinking field. adaptive -> {\"type\":\"adaptive\"}; budget -> {\"type\":\"enabled\",\"budget_tokens\":N}; disabled -> {\"type\":\"disabled\"}; off -> no thinking field at all."},
        "enabled":          {"type": "boolean", "description": "Deprecated alias for mode: true -> adaptive, false -> off. Ignored when mode is set."},
        "budget_tokens":    {"type": "integer", "description": "Required when mode: budget; ignored otherwise. 0 with no mode set means thinking is off."},
        "display":          {"type": "string", "enum": ["summarized", "omitted"], "description": "Whether the API returns readable reasoning text. Unset sends no display key, so the model's own default applies; unset with include_thoughts true infers summarized under mode adaptive or budget."},
        "include_thoughts": {"type": "boolean"}
      }
    },
    "output_config": {
      "type": "object",
      "additionalProperties": false,
      "description": "Mirrors the wire object of the same name. Emitted as output_config on the request body, merged with anything else that writes it.",
      "properties": {
        "effort": {
          "type": "string",
          "enum": [
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "description": "Reasoning depth, emitted as output_config.effort. Anthropic's own five are low, medium, high, xhigh and max; Gemini's minimal is accepted and clamped to low (warned once at Init) so a value shared with the other provider stays configurable. Independent of thinking.mode — sent whatever the thinking configuration is, including mode: off. Unset sends no effort key, so the API default (high) applies. The provider never inspects the model id: a level the target model does not accept is an Anthropic 400."
        }
      }
    },
    "multimodal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pdf_beta": {"type": "boolean"}
      }
    },
    "citations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "structured_outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode":        {"type": "string", "enum": ["tool", "native"]},
        "beta_header": {"type": "string"}
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":            {"type": "boolean"},
        "upload_threshold":   {"type": "integer", "minimum": 0},
        "cache_uploads":      {"type": "boolean"},
        "delete_on_shutdown": {"type": "boolean"}
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "description": "Backoff configuration shared by every provider.",
      "properties": {
        "enabled":       {"type": "boolean"},
        "max_retries":   {"type": "integer", "minimum": 0},
        "initial_delay": {"type": "string"},
        "max_delay":     {"type": "string"},
        "backoff":       {"type": "string", "enum": ["constant", "linear", "exponential", "exponential_jitter"]},
        "multiplier":    {"type": "number", "minimum": 0},
        "statuses":      {"type": "array", "items": {"type": "integer"}}
      }
    },
    "pricing": {
      "type": "object",
      "description": "Per-model pricing overrides; keys are model IDs.",
      "additionalProperties": true
    }
  }
}
